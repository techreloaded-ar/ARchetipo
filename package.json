{
  "scripts": {
    "test": "npm run test:cli",
    "build:cli": "cd cli && go run github.com/goreleaser/goreleaser/v2@v2.15.4 release --snapshot --clean",
    "build:cli:dev": "node ./scripts/build-cli-dev.mjs",
    "install:dev": "node ./scripts/install-dev.mjs",
    "uninstall:dev": "node ./scripts/uninstall-dev.mjs",
    "release:cli": "cd cli && go run github.com/goreleaser/goreleaser/v2@v2.15.4 release --clean",
    "build:npm": "node ./scripts/build-npm.mjs",
    "publish:npm": "node ./scripts/publish-npm.mjs",
    "test:cli": "cd cli && go test ./...",
    "test:web": "node --test \"test/web/**/*.test.mjs\"",
    "test:e2e": "node ./test/e2e/run.mjs",
    "test:e2e:unit": "node --test ./test/e2e/config.test.mjs ./test/e2e/baseline.test.mjs",
    "test:wiki-benchmark": "node ./test/benchmark/wiki/run.mjs",
    "test:wiki-benchmark:unit": "node --test ./test/benchmark/wiki/run.test.mjs",
    "test:view-create-smoke": "node ./test/e2e/create-spec-view-smoke.mjs",
    "test:view-workspace-smoke": "node ./test/e2e/create-workspace-view-smoke.mjs",
    "test:view-workspaces-smoke": "node ./test/e2e/known-workspaces-view-smoke.mjs",
    "test:view-open-workspace-smoke": "node ./test/e2e/open-workspace-view-smoke.mjs",
    "test:view-delete-smoke": "node ./test/e2e/delete-story-view-smoke.mjs",
    "test:view-execution-smoke": "node ./test/e2e/execution-config-view-smoke.mjs",
    "test:view-plan-smoke": "node ./test/e2e/plan-from-view-smoke.mjs",
    "test:view-run-smoke": "node ./test/e2e/run-from-view-smoke.mjs",
    "test:view-local-run-smoke": "node ./test/e2e/local-run-view-smoke.mjs",
    "test:view-inception-smoke": "node ./test/e2e/inception-from-view-smoke.mjs",
    "test:view-backlog-smoke": "node ./test/e2e/backlog-from-view-smoke.mjs",
    "test:view-workspace-status-smoke": "node ./test/e2e/workspace-status-view-smoke.mjs",
    "test:view-spec-draft-smoke": "node ./test/e2e/spec-draft-from-view-smoke.mjs",
    "test:wiki-smoke": "node ./test/e2e/wiki-smoke.mjs"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  }
}
